# ── PIN configuration ──────────────────────────────────────────────────────
# Never commit real values. Everything here has a safe default; only the key
# file path must point at a testnet-ONLY burner key.

# Wallet key file: one 64-hex private key (0x optional). MUST be a dedicated
# testnet burner — it signs real orders on Shannon (chain 50312). Never reuse
# a key that ever touched mainnet funds. chmod 600 it.
PIN_KEY_FILE=data/pin_key.txt

# 1 (default) = shadow quotes only — no transactions. 0 = place real orders
# (still bounded by the hard caps + balance floor compiled into live.ts).
LIVE_DRY=1

# How many windows the runner trades before stopping (default 40).
LIVE_MAX_WINDOWS=40

# Optional: 64-hex key of a SECOND burner that already holds testnet STT, used
# by fund.ts for a one-time gas transfer. Omit to use the Telegram faucet instead.
# DONOR_PK=

# Advanced overrides (defaults are correct for the DreamDEX EC venue on
# testnet; only set if contracts moved):
# PIN_HOST_RPC=https://api.infra.testnet.somnia.network
# PIN_INDEXER=https://dev.smk.somnia.host/v1/graphql
# PIN_WS=wss://api.infra.testnet.somnia.network/ws
